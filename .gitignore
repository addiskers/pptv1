.env
__pycache__/
examples/out/
*.egg-info/
.pytest_cache/
eval/baselines/*.pptx
# derived image caches — regenerated on demand
assets/icons/cache/
assets/cache_faded/
assets/cache_crop/
# corpus-derived data (client-confidential source material) — never committed
corpus/work/

# runtime user uploads (logos) - never committed
assets/uploads/

# session signing secret - never committed
data/.secret

# durable job storage on servers
data/jobs/
assets/cache_rings/

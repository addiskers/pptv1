    {
      "slide_type": "exec_summary",
      "title": "Interventions lifted incomes above state averages in all three focus states",
      "sections": [
        {
          "heading": "Reach",
          "body": "Programs reached **3M farmers directly** and 3M more through diffusion in AY 2024-25, with digital channels adding **66M** touchpoints across advisory, market linkage and DPI rails."
        },
        {
          "heading": "Income",
          "body": "Direct-beneficiary households out-earned state averages in every geography — **+2.7%** in Uttar Pradesh, **+5%** in Bihar and **+4.8%** in Odisha from crops and livestock."
        },
        {
          "heading": "Resilience",
          "body": "Advisory recipients cut crop losses by **2-8 percentage points**, worth $14-31 per farmer per season depending on state."
        },
        {
          "heading": "Leverage",
          "body": "Government and private partners co-invested **$1,426 Mn** against program funding, with a 64% adoption rate of programmatic interventions."
        }
      ]
    },

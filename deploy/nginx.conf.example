# DeckEngine reverse proxy for fmcg.skyquestinsights.com
# 1) Point the domain's A record at this EC2 instance's public IP.
# 2) Put this at /etc/nginx/conf.d/deckengine.conf (edit paths if needed).
# 3) sudo dnf install -y nginx certbot python3-certbot-nginx
#    sudo systemctl enable --now nginx
#    sudo certbot --nginx -d fmcg.skyquestinsights.com   # provisions TLS
# certbot rewrites the :80 server block to redirect to :443 automatically.

server {
    listen 80;
    server_name fmcg.skyquestinsights.com;

    client_max_body_size 12m;        # room for CSV uploads / large specs

    location / {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;      # deck generation can take 60-120s
        proxy_send_timeout 300s;
    }
}

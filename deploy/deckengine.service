[Unit]
Description=DeckEngine API
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/deckengine
# Put secrets in /home/ec2-user/deckengine/.env (KEY=VALUE per line); .env is
# gitignored and auto-loaded by the app (envfile.load_env).
# .env is the SINGLE source of truth for DECKENGINE_* settings —
# EnvironmentFile overrides Environment= lines, so never set preview/keys
# here (a stale Environment= line masked the real preview mode once).
EnvironmentFile=-/home/ec2-user/deckengine/.env
Environment=HOST=127.0.0.1
Environment=PORT=8000
# ONE worker: job state lives in process memory between persist points, and
# background generation threads belong to the process that accepted the job.
# Two workers split-brain the job table (polls 404, approvals fail).
Environment=WORKERS=1
# durable deck storage — /tmp loses user deliverables to restarts/cleanup
Environment=DECKENGINE_JOBS_DIR=/home/ec2-user/deckengine/data/jobs
ExecStart=/home/ec2-user/deckengine/deploy/run.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
